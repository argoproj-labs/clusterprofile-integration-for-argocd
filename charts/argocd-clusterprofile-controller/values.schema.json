{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "affinity": {
      "description": "Affinity rules for the controller pod.",
      "type": "object"
    },
    "apiVersionOverrides": {
      "description": "Override the monitoring resource API version with `apiVersionOverrides.monitoring`. Empty uses `monitoring.coreos.com/v1`.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "containerSecurityContext": {
      "description": "Container-level security context.",
      "type": "object"
    },
    "controller": {
      "type": "object",
      "required": [
        "name",
        "args",
        "clusterProfileProvidersFile",
        "clusterProfileNamespaces",
        "metricsPort",
        "probePort",
        "dryRun",
        "debug",
        "logFormat",
        "logLevel",
        "argoCDCmdParams",
        "extraEnv",
        "extraEnvFrom",
        "extraVolumeMounts",
        "extraVolumes",
        "metrics"
      ],
      "properties": {
        "argoCDCmdParams": {
          "type": "object",
          "required": [
            "enabled",
            "configMapName"
          ],
          "properties": {
            "configMapName": {
              "description": "ConfigMap name containing Argo CD command parameters.",
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
              "maxLength": 63,
              "minLength": 1
            },
            "enabled": {
              "description": "Read optional Argo CD command parameter keys from a ConfigMap.",
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "args": {
          "description": "Extra command-line arguments for the controller.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "clusterProfileNamespaces": {
          "description": "Namespaces to watch for ClusterProfile resources. Empty uses the release namespace; `*` watches all namespaces.",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "maxLength": 63
              }
            },
            {
              "type": "array",
              "maxItems": 1,
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": [
                  "*"
                ]
              }
            }
          ],
          "uniqueItems": true
        },
        "clusterProfileProvidersFile": {
          "description": "Path to a mounted ClusterProfile providers file.",
          "type": "string"
        },
        "debug": {
          "description": "Enable debug logging. Takes precedence over logLevel.",
          "type": "boolean"
        },
        "dryRun": {
          "description": "Enable dry-run mode.",
          "type": "boolean"
        },
        "extraEnv": {
          "description": "Extra environment variables for the controller container.",
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraEnvFrom": {
          "description": "Extra envFrom entries for the controller container.",
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraVolumeMounts": {
          "description": "Extra volume mounts for the controller container.",
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraVolumes": {
          "description": "Extra volumes for the controller pod.",
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "logFormat": {
          "description": "Explicit log format (`json` or `text`). Empty keeps the controller default or Argo CD cmd params value.",
          "type": "string",
          "enum": [
            "",
            "json",
            "text"
          ]
        },
        "logLevel": {
          "description": "Explicit log level (`debug`, `info`, `warn`, `error`). Empty keeps the controller default or Argo CD cmd params value.",
          "type": "string",
          "enum": [
            "",
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "metrics": {
          "type": "object",
          "required": [
            "enabled",
            "service",
            "serviceMonitor",
            "rules"
          ],
          "properties": {
            "enabled": {
              "description": "Create a metrics Service.",
              "type": "boolean"
            },
            "rules": {
              "type": "object",
              "required": [
                "enabled",
                "namespace",
                "selector",
                "additionalLabels",
                "annotations",
                "spec"
              ],
              "properties": {
                "additionalLabels": {
                  "description": "Additional labels for the PrometheusRule.",
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "annotations": {
                  "description": "Annotations for the PrometheusRule.",
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "enabled": {
                  "description": "Create a PrometheusRule from rules.spec.",
                  "type": "boolean"
                },
                "namespace": {
                  "description": "Namespace for the PrometheusRule. Empty uses the controller namespace.",
                  "type": "string",
                  "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                  "maxLength": 63
                },
                "selector": {
                  "description": "Labels added to the PrometheusRule for selection by Prometheus.",
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "spec": {
                  "description": "Alerting and recording rules. See the `spec.groups[0].rules` list in the [inventory alert examples](../../artifacts/overlays/monitoring/prometheus-rule.yaml).",
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              },
              "additionalProperties": false
            },
            "service": {
              "type": "object",
              "required": [
                "type",
                "clusterIP",
                "annotations",
                "labels",
                "servicePort",
                "portName"
              ],
              "properties": {
                "annotations": {
                  "description": "Extra annotations for the metrics Service.",
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "clusterIP": {
                  "description": "Metrics Service cluster IP. Empty lets Kubernetes assign an IP; `None` creates a headless Service when type is ClusterIP.",
                  "type": "string"
                },
                "labels": {
                  "description": "Extra labels for the metrics Service.",
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "portName": {
                  "description": "Metrics Service port name referenced by the ServiceMonitor.",
                  "type": "string",
                  "minLength": 1
                },
                "servicePort": {
                  "description": "Metrics Service port.",
                  "type": "integer",
                  "maximum": 65535,
                  "minimum": 1
                },
                "type": {
                  "description": "Metrics Service type.",
                  "type": "string",
                  "enum": [
                    "ClusterIP",
                    "NodePort",
                    "LoadBalancer"
                  ]
                }
              },
              "additionalProperties": false
            },
            "serviceMonitor": {
              "type": "object",
              "required": [
                "enabled",
                "interval",
                "scrapeTimeout",
                "honorLabels",
                "relabelings",
                "metricRelabelings",
                "selector",
                "scheme",
                "tlsConfig",
                "namespace",
                "additionalLabels",
                "annotations"
              ],
              "properties": {
                "additionalLabels": {
                  "description": "Additional labels for the ServiceMonitor.",
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "annotations": {
                  "description": "Annotations for the ServiceMonitor.",
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "enabled": {
                  "description": "Create a Prometheus Operator ServiceMonitor for the metrics Service.",
                  "type": "boolean"
                },
                "honorLabels": {
                  "description": "Preserve labels exposed by the controller when they conflict with target labels.",
                  "type": "boolean"
                },
                "interval": {
                  "description": "Interval between Prometheus scrapes. Empty omits the interval and uses the Prometheus configuration.",
                  "type": "string"
                },
                "metricRelabelings": {
                  "description": "Relabeling rules applied before samples are ingested.",
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "namespace": {
                  "description": "Namespace for the ServiceMonitor. Empty uses the controller namespace.",
                  "type": "string",
                  "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                  "maxLength": 63
                },
                "relabelings": {
                  "description": "Relabeling rules applied before scraping.",
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "scheme": {
                  "description": "Metrics endpoint scheme. Empty uses the ServiceMonitor default (`http`).",
                  "type": "string",
                  "enum": [
                    "",
                    "http",
                    "https"
                  ]
                },
                "scrapeTimeout": {
                  "description": "Per-scrape timeout. Empty uses the Prometheus default.",
                  "type": "string"
                },
                "selector": {
                  "description": "Labels added to the ServiceMonitor for selection by Prometheus.",
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "tlsConfig": {
                  "description": "TLS configuration for the metrics endpoint.",
                  "type": "object"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "metricsPort": {
          "description": "Metrics port.",
          "type": "integer",
          "maximum": 65535,
          "minimum": 1
        },
        "name": {
          "description": "Controller component name.",
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63,
          "minLength": 1
        },
        "probePort": {
          "description": "Health probe port.",
          "type": "integer",
          "maximum": 65535,
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "fullnameOverride": {
      "description": "String to fully override the base fully-qualified resource name.",
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 63
    },
    "global": {
      "description": "Global values reserved for parent charts.",
      "type": "object"
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "pullPolicy": {
          "description": "Image pull policy for the controller container.",
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "repository": {
          "description": "Container image repository for the controller.",
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "description": "Overrides the image tag whose default is the chart appVersion.",
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$",
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "description": "Image pull secrets for the controller pod.",
      "allOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
                "maxLength": 253,
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      ]
    },
    "nameOverride": {
      "description": "Provide a name in place of `argocd`.",
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 63
    },
    "namespaceOverride": {
      "description": "Override the Kubernetes namespace used in rendered namespaced resources.",
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 63
    },
    "networkPolicy": {
      "type": "object",
      "required": [
        "enabled",
        "ingress"
      ],
      "properties": {
        "enabled": {
          "description": "Create a NetworkPolicy allowing access to the metrics port.",
          "type": "boolean"
        },
        "ingress": {
          "type": "object",
          "required": [
            "namespaceSelector"
          ],
          "properties": {
            "namespaceSelector": {
              "description": "Namespace selector allowed to access the metrics port.",
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "nodeSelector": {
      "description": "Node selector for the controller pod.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podAnnotations": {
      "description": "Extra annotations for the controller pods.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podDisruptionBudget": {
      "oneOf": [
        {
          "properties": {
            "maxUnavailable": {
              "type": "null"
            },
            "minAvailable": {
              "not": {
                "type": "null"
              }
            }
          }
        },
        {
          "properties": {
            "maxUnavailable": {
              "not": {
                "type": "null"
              }
            },
            "minAvailable": {
              "type": "null"
            }
          }
        }
      ],
      "required": [
        "enabled",
        "unhealthyPodEvictionPolicy",
        "labels",
        "annotations"
      ],
      "properties": {
        "annotations": {
          "description": "Extra annotations for the PodDisruptionBudget.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "enabled": {
          "description": "Create a PodDisruptionBudget for the controller.",
          "type": "boolean"
        },
        "labels": {
          "description": "Extra labels for the PodDisruptionBudget.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "maxUnavailable": {
          "description": "Maximum number or percentage of controller Pods that may be unavailable. Set minAvailable to null when using this field.",
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^(100|[1-9]?[0-9])%$"
            },
            {
              "type": "null"
            }
          ]
        },
        "minAvailable": {
          "description": "Minimum number or percentage of controller Pods that must remain available. Set maxUnavailable to null when using this field.",
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^(100|[1-9]?[0-9])%$"
            },
            {
              "type": "null"
            }
          ]
        },
        "unhealthyPodEvictionPolicy": {
          "description": "Policy for evicting unhealthy Pods. Empty uses the Kubernetes default.",
          "type": "string",
          "enum": [
            "",
            "IfHealthyBudget",
            "AlwaysAllow"
          ]
        }
      },
      "additionalProperties": false
    },
    "podLabels": {
      "description": "Extra labels for the controller pods.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podSecurityContext": {
      "description": "Pod-level security context.",
      "type": "object"
    },
    "priorityClassName": {
      "description": "Priority class name for the controller pod.",
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
      "maxLength": 253
    },
    "rbac": {
      "type": "object",
      "required": [
        "create"
      ],
      "properties": {
        "create": {
          "description": "Create RBAC resources for the controller.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "replicaCount": {
      "description": "Number of controller replicas.",
      "type": "integer",
      "minimum": 0
    },
    "resources": {
      "description": "Resource requests and limits for the controller container.",
      "type": "object"
    },
    "serviceAccount": {
      "type": "object",
      "required": [
        "create",
        "name",
        "annotations",
        "labels"
      ],
      "properties": {
        "annotations": {
          "description": "Extra annotations for the service account.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "create": {
          "description": "Create a service account for the controller.",
          "type": "boolean"
        },
        "labels": {
          "description": "Extra labels for the service account.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "name": {
          "description": "Controller service account name.",
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63,
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "terminationGracePeriodSeconds": {
      "description": "Pod termination grace period in seconds.",
      "type": "integer",
      "maximum": 3600,
      "minimum": 30
    },
    "tolerations": {
      "description": "Tolerations for the controller pod.",
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "topologySpreadConstraints": {
      "description": "Topology spread constraints for the controller pods.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "matchLabelKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "maxSkew": {
            "type": "integer"
          },
          "topologyKey": {
            "type": "string"
          },
          "whenUnsatisfiable": {
            "type": "string"
          }
        }
      }
    },
    "vpa": {
      "type": "object",
      "required": [
        "enabled",
        "labels",
        "annotations",
        "updateMode",
        "containerPolicy"
      ],
      "properties": {
        "annotations": {
          "description": "Extra annotations for the VerticalPodAutoscaler.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "containerPolicy": {
          "description": "VPA policy for the controller container, excluding `containerName`.",
          "type": "object"
        },
        "enabled": {
          "description": "Create a VerticalPodAutoscaler for the controller.",
          "type": "boolean"
        },
        "labels": {
          "description": "Extra labels for the VerticalPodAutoscaler.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "updateMode": {
          "description": "VPA update mode.",
          "type": "string",
          "enum": [
            "Off",
            "Initial",
            "Recreate",
            "InPlaceOrRecreate"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
